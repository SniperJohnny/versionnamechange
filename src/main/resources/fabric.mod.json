{
	"schemaVersion": 1,
	"id": "versionnamechange",
	"version": "${version}",
	"name": "VersionnameChange",
	"description": "You dont like the version name? No problem change it to your liking with version name change!",
	"authors": [
		"SniperJohnny"
	],
	"contact": {
		"issues": "https://github.com/SniperJohnny/versionnamechange/issues",
		"sources": "https://github.com/SniperJohnny/versionnamechange"
	},
	"license": "MIT",
	"icon": "assets/versionnamechange/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.sniperjohnny.github.versionnamechange.VersionnameChange"
		],
		"client": [
			"io.sniperjohnny.github.versionnamechange.client.VersionnameChangeClient"
		],
		"fabric-datagen": [
			"io.sniperjohnny.github.versionnamechange.client.VersionnameChangeDataGenerator"
		]
	},
	"mixins": [
		"versionnamechange.mixins.json",
		{
			"config": "versionnamechange.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.1 <26.4",
		"java": ">=25",
		"fabric-api": "*"
	}
}